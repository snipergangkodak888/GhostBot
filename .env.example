# Production template — set these in Railway (not in .env.local).
# For local dev, copy .env.local.example -> .env.local instead.

APP_ENV=production

# Supabase production project — use the same project ref in all Supabase values.
SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase database connection for schema setup.
# Recommended for Railway: Supabase Connect -> Session pooler -> URI.
# Username must look like postgres.PROJECT_REF and port should be 5432.
SUPABASE_POOLER_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_POOLER_REGION=aws-0-us-east-1

PRODUCTION_SUPABASE_PROJECT_REF=your-prod-project-ref

# Admin bootstrap account created by pnpm db:init.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin
ADMIN_JWT_SECRET=replace-with-a-long-random-secret

# Public app URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
NEXT_PUBLIC_BOT_USERNAME=your_bot_username
TELEGRAM_INITDATA_MAX_AGE_SEC=86400

# Telegram user account used only for full organic-channel automation.
# Generate TELEGRAM_USER_SESSION locally with `npm run telegram:user:authorize`.
# Treat API hash and session as secrets; never commit real values.
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=
TELEGRAM_USER_SESSION=
SUMO_TRADE_BOT_USERNAME=sumo_trade_bot
SUMO_CHANNEL_LOGO_PATH=public/logos/sumo-black.jpg

# Cron protection
CRON_SECRET=replace-with-a-long-random-secret

# Telegram analytics, optional
NEXT_PUBLIC_TG_ANALYTICS_TOKEN=
NEXT_PUBLIC_TG_ANALYTICS_APP_NAME=

# Optional admin-only endpoint protection
ADMIN_TOKEN=
START_MESSAGE_ADMIN_TOKEN=

# Revenue accounting (wallets are public; secrets must stay in Railway variables)
REVENUE_EVM_WALLET=0xC288D2B436C4Ae29913C6f094Fc502ff4DC3BCb6
REVENUE_SOLANA_WALLET=FPTgwwoMC4Qdc3DvDdz8PaNovn6hkQAdPH2nGRfsxiHh
REVENUE_SOLANA_TREASURY_WALLET=7u6Wj3VCLYfqW4qDw6jn4sGtNM5uv6CNX7FFiuhJomiA
REVENUE_NOTIFICATION_MIN_USD=1
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo
# Optional allowlist for additional token contracts/mints. Shape: {"chain":{"address":{"asset":"USDC","decimals":6}}}
REVENUE_TOKEN_REGISTRY_JSON={}
QUICKNODE_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
FEE_INBOX_CHAT_ID=
