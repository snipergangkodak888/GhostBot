[
  {
    "name": "shows the main menu",
    "text": "/menu",
    "resetBefore": true,
    "expectIncludes": ["Ghost Team bot is ready", "/profit", "/projects"]
  },
  {
    "name": "lists projects",
    "text": "/projects",
    "expectIncludes": ["Projects"]
  },
  {
    "name": "starts and cancels AI input state",
    "text": "/ai",
    "resetBefore": true,
    "expectIncludes": ["Send your AI question now", "/cancel"]
  },
  {
    "name": "cancels the active state",
    "text": "/cancel",
    "expectIncludes": ["Cancelled"]
  },
  {
    "name": "routes an inline main-menu callback",
    "callbackData": "main:menu",
    "resetBefore": true,
    "expectIncludes": ["Ghost Team bot is ready"]
  },
  {
    "name": "starts the launch capital calculator",
    "text": "/launchcalc",
    "resetBefore": true,
    "expectIncludes": ["Launch capital calculator", "Choose the blockchain"]
  },
  {
    "name": "selects BNB Chain for a launch quote",
    "callbackData": "launch:chain:bsc",
    "expectIncludes": ["BNB Chain", "launchpad or DEX"]
  },
  {
    "name": "selects Flap for a launch quote",
    "callbackData": "launch:venue:flap",
    "expectIncludes": ["Flap", "calculator solve for"]
  },
  {
    "name": "selects supply control as the launch target",
    "callbackData": "launch:metric:supply:flap",
    "expectIncludes": ["desired total supply control", "67.37%"]
  },
  {
    "name": "calculates a forwardable Flap launch quote",
    "text": "67.37%",
    "expectIncludes": ["Capital requirement", "16.55 BNB total", "9.55 BNB for supply accumulation", "67.37% supply control", "aged wallets + Husher funding", "initial MM trading liquidity"],
    "expectExcludes": ["Flap launch estimate", "Estimated using a live", "Bundle + migration snipe"]
  },
  {
    "name": "starts a Pump.fun launch quote",
    "text": "/launchcalc",
    "resetBefore": true,
    "expectIncludes": ["Choose the blockchain"]
  },
  {
    "name": "selects Solana for a launch quote",
    "callbackData": "launch:chain:sol",
    "expectIncludes": ["Solana", "launchpad or DEX"]
  },
  {
    "name": "selects Pump.fun for a launch quote",
    "callbackData": "launch:venue:pumpfun",
    "expectIncludes": ["Pump.fun", "calculator solve for"]
  },
  {
    "name": "selects Pump.fun supply control",
    "callbackData": "launch:metric:supply:pumpfun",
    "expectIncludes": ["desired total supply control"]
  },
  {
    "name": "calculates the Pump.fun curve and migration quote",
    "text": "87.26%",
    "expectIncludes": ["197.6 SOL total", "86.93 SOL to capture the full Pump.fun bonding curve", "53.17 SOL migration snipe", "17.5 SOL for initial/pass-through"]
  },
  {
    "name": "starts a Robinhood Chain launch quote",
    "text": "/launchcalc",
    "resetBefore": true,
    "expectIncludes": ["Choose the blockchain"]
  },
  {
    "name": "selects Robinhood Chain for a launch quote",
    "callbackData": "launch:chain:rh",
    "expectIncludes": ["Robinhood Chain", "launchpad or DEX"]
  },
  {
    "name": "selects Pons V2 on Robinhood Chain",
    "callbackData": "launch:venue:pons",
    "expectIncludes": ["Pons V2", "calculator solve for"]
  },
  {
    "name": "selects Pons supply control",
    "callbackData": "launch:metric:supply:pons",
    "expectIncludes": ["desired total supply control"]
  },
  {
    "name": "calculates a forwardable Pons launch quote",
    "text": "70%",
    "expectIncludes": ["7.92 ETH total", "3.92 ETH for supply accumulation", "70% supply control", "1.5 ETH for aged wallets", "2.5 ETH designated for initial MM trading liquidity"]
  },
  {
    "name": "returns to Robinhood Chain venues",
    "callbackData": "launch:chain:rh",
    "expectIncludes": ["Robinhood Chain", "launchpad or DEX"]
  },
  {
    "name": "selects Flap on Robinhood Chain",
    "callbackData": "launch:venue:flap-rh",
    "expectIncludes": ["Flap", "calculator solve for"]
  },
  {
    "name": "selects Robinhood Flap supply control",
    "callbackData": "launch:metric:supply:flap-rh",
    "expectIncludes": ["desired total supply control"]
  },
  {
    "name": "calculates a forwardable Robinhood Flap launch quote",
    "text": "70%",
    "expectIncludes": ["7.3 ETH total", "3.3 ETH for supply accumulation", "70% supply control", "1.5 ETH for aged wallets", "2.5 ETH designated for initial MM trading liquidity"]
  },
  {
    "name": "selects Uniswap V2 on Robinhood Chain",
    "callbackData": "launch:venue:uni-rh-v2",
    "expectIncludes": ["Uniswap V2", "calculator solve for"]
  },
  {
    "name": "selects Robinhood supply control and requests LP",
    "callbackData": "launch:metric:supply:uni-rh-v2",
    "expectIncludes": ["What initial LP", "suggested default"]
  },
  {
    "name": "uses the default Robinhood LP",
    "callbackData": "launch:lp:default:uni-rh-v2",
    "expectIncludes": ["desired total supply control"]
  },
  {
    "name": "calculates a forwardable Robinhood launch quote",
    "text": "93%",
    "expectIncludes": ["Assuming a 0.5 ETH initial LP", "11.14 ETH total", "0.5 ETH for initial LP", "6.64 ETH for supply accumulation", "1.5 ETH for aged wallets"]
  },
  {
    "name": "shows timezone setup",
    "text": "/timezone",
    "resetBefore": true,
    "expectIncludes": ["timezone"]
  },
  {
    "name": "asks an unknown member for timezone before an ambiguous reminder",
    "telegramId": 990000123,
    "text": "remind the team tomorrow at 9 to review launches",
    "resetBefore": true,
    "expectIncludes": ["What timezone should I use"]
  },
  {
    "name": "saves a timezone from an inline choice",
    "callbackData": "tz:set:pt:990000099",
    "expectIncludes": ["America/Los_Angeles", "PT"]
  },
  {
    "name": "schedules a naturally phrased project launch",
    "text": "prime launch tomorrow 9am et",
    "resetBefore": true,
    "expectIncludes": ["Action: Create project", "New project: Prime", "Launch:", "ET"]
  },
  {
    "name": "understands conversational launch-calendar wording",
    "text": "we have a launch (prime) tomorrow at 9am et, please add it to the launch calendar",
    "resetBefore": true,
    "expectIncludes": ["Action: Create project", "New project: Prime", "Launch:", "ET"]
  },
  {
    "name": "updates an existing project launch from statement-style language",
    "text": "hey launches next friday at 3pm pt",
    "resetBefore": true,
    "expectIncludes": ["Action: Update project", "Project: hey", "Launch:", "PT"]
  },
  {
    "name": "accepts polite natural mutation wording",
    "text": "please schedule hey launch for next monday at noon pt",
    "resetBefore": true,
    "expectIncludes": ["Action: Update project", "Project: hey", "Launch:", "12:00 PM", "PT"]
  },
  {
    "name": "clarifies conflicting relative and explicit dates",
    "text": "prime launch tomorrow, August 31 2099 at 9am ET",
    "resetBefore": true,
    "expectIncludes": ["two different dates", "tomorrow is", "2099-08-31", "Which date should I use"]
  },
  {
    "name": "configures a Launch Chat with its default schedule",
    "telegramId": 990000099,
    "chatId": 990000987,
    "chatType": "group",
    "text": "/setchat launch",
    "resetBefore": true,
    "expectIncludes": ["Launch Chat", "Automatic notifications: Launch updates", "Guard enrollment:"],
    "expectButtonUrlIncludes": ["https://t.me/ghostbot_local_lab?start=guard_"]
  },
  {
    "name": "lists launch schedule subscriptions",
    "telegramId": 990000099,
    "chatId": 990000987,
    "chatType": "group",
    "text": "/subscriptions",
    "expectIncludes": ["Scheduled updates for this chat", "Launch updates"]
  },
  {
    "name": "unsubscribes a group from launch schedules",
    "telegramId": 990000099,
    "chatId": 990000987,
    "chatType": "group",
    "text": "/unsubscribe launches",
    "expectIncludes": ["no longer subscribed to Launch updates"]
  },
  {
    "name": "resubscribes a Launch Chat to launch schedules",
    "telegramId": 990000099,
    "chatId": 990000987,
    "chatType": "group",
    "text": "/subscribe launches",
    "expectIncludes": ["subscribed to Launch updates", "each morning in ET"]
  },
  {
    "name": "configures a Trade Floor without automatic updates",
    "telegramId": 990000099,
    "chatId": 990000988,
    "chatType": "group",
    "text": "/setchat trade",
    "resetBefore": true,
    "expectIncludes": ["Trade Floor", "Automatic notifications: none"]
  },
  {
    "name": "rejects the removed daily Trade Floor digest",
    "telegramId": 990000099,
    "chatId": 990000988,
    "chatType": "group",
    "text": "/subscribe daily",
    "expectIncludes": ["Trade Floor automatic daily updates have been removed"]
  },
  {
    "name": "configures a Launch Chat with launch notifications",
    "telegramId": 990000099,
    "chatId": 990000988,
    "chatType": "group",
    "text": "/setchat launch",
    "expectIncludes": ["Launch Chat", "Automatic notifications: Launch updates"]
  },
  {
    "name": "blocks revenue commands inside a Launch Chat",
    "telegramId": 990000099,
    "chatId": 990000988,
    "chatType": "group",
    "text": "/fees",
    "expectIncludes": ["Financial, revenue, receipt, and payroll information is not available"]
  },
  {
    "name": "rejects the disabled automatic finance report",
    "telegramId": 990000099,
    "chatId": 990000988,
    "chatType": "group",
    "text": "/subscribe finance",
    "expectIncludes": ["Finance Chat automatic reports are disabled"]
  },
  {
    "name": "blocks revenue callbacks inside a Launch Chat",
    "telegramId": 990000099,
    "chatId": 990000988,
    "chatType": "group",
    "callbackData": "receipt:classify:not-a-real-receipt",
    "expectIncludes": ["Financial, revenue, receipt, and payroll information is not available"]
  },
  {
    "name": "allows natural-language launch actions inside a Launch Chat",
    "telegramId": 990000099,
    "chatId": 990000988,
    "chatType": "group",
    "text": "/ai launch Permissions Test Project tomorrow at 3pm ET",
    "expectIncludes": ["Action: Create project", "Permissions Test", "Confirm before I change anything?"]
  }
]
